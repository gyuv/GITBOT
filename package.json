{
  "name": "gitbot",
  "version": "1.0.0",
  "private": true,
  "description": "A cheerful chibi android GitHub App that watches over gyuv's repositories ✨",
  "author": "Yuvaraj (gyuv)",
  "license": "ISC",
  "type": "module",
  "main": "index.js",
  "scripts": {
