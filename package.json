    "check": "node --check index.js && node --check profile/profile-updater.js"
  },
  "dependencies": {
    "probot": "^13.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "smee-client": "^2.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
